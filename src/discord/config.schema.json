{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Discord bots config",
    "type": "object",
    "required": ["public", "private"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "public": {
            "type": "object",
            "required": ["token"],
            "additionalProperties": false,
            "properties": {
                "token": { "type": "string", "description": "Public Discord bot token." }
            }
        },
        "private": {
            "type": "object",
            "required": ["whitelist", "api_token"],
            "additionalProperties": false,
            "description": "Admin Discord surface on the same bot token.",
            "properties": {
                "whitelist": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "description": "Discord user IDs allowed to use /admin."
                },
                "api_token": {
                    "type": "string",
                    "description": "Same value as Flask cfg api_token. Sent as the Authorization header."
                }
            }
        }
    }
}
