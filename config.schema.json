{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VPN Config",
    "description": "Static deployment and presentation settings. Mutable user, quota, code, notification, Telegram, and snapshot state is stored in SQLite.",
    "type": "object",
    "required": [
        "uri", "api_token", "api_admin_ui_auth", "provider_id", "panel_alert_cooldown", "salt", "fingerprints", "nodes",
        "json_template", "bypass_packages", "domain", "ping_check_url",
        "3xui", "sub_name", "profiles", "redis"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string", "description": "Schema file." },
        "uri": { "type": "string", "description": "Main URI for the service.", "default": "sub" },
        "api_uri": { "type": "string", "description": "Admin API URI." },
        "api_admin_ui_auth": {
        	"type": "array",
        	"prefixItems": [
        		{ "type": "string", "description": "Username"},
        		{ "type": "string", "description": "Password"}
        	],
        	"items": false,
        	"minItems": 2,
        	"maxItems": 2
        },
        "provider_id": { "type": "string" },
        "fallback_domain": { "type": "string", "description": "Fallback domain to retrieve the subscription from. Only works with Happ and if provider id is present.\nMust host a mirror of this service." },
        "api_token": { "type": "string", "description": "Admin API Access token." },
        "panel_alert_cooldown": { "type": "integer", "description": "Panel alert cooldown in seconds.", "default": 3600 },
        "domain": { "type": "string", "description": "Your domain." },
        "ping_check_url": { "type": "string", "description": "URL used for checking connectivity in Happ, works with provider id only, must return 204." },
        "salt": { "type": "string", "description": "Salt for passwords, pick something strong." },
        "sub_name": { "type": "string", "description": "Text displayed in VPN clients." },

        "fingerprints": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "default": ["safari", "chrome", "edge", "firefox"],
            "description": "List of allowed fingerprints. Dont add anything invalid, see xray uTLS section for the full list."
        },

        "nodes": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "List of nodes. Must be raw domains or IPs."
        },

        "bot": {
            "type": "object",
            "required": ["token", "whitelist"],
            "additionalProperties": false,
            "description": "Optional admin bot. Omit the key, or leave token empty, to not start it.",
            "properties": {
                "token": { "type": "string", "description": "Token for your admin bot." },
                "whitelist": {
                    "type": "array",
                    "description": "List of users who are allowed to use the admin bot (UIDs)",
                    "default": [],
                    "items": { "type": "integer" }
                }
            }
        },

        "json_template": {
            "type": "object",
            "description": "JSON Profile template.",
            "default": {},
            "required": ["dns", "routing", "inbounds", "outbounds", "remarks"],
            "properties": {
                "servers": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["servers", "queryStrategy"],
                    "properties": {
                        "servers": { "type": "array" },
                        "queryStrategy": { "type": "string" }
                    }
                },
                "routing": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["rules", "domainStrategy"],
                    "$comment": "im not writing a full schema"
                }
            },
            "additionalProperties": true
        },

        "bypass_packages": {
        	"type": "array",
        	"description": "List of packages (android) to bypass",
        	"items": { "type": "string" }
        },
        
        "funny_strings": {
            "type": "array",
            "description": "type shit",
            "items": { "type": "string" }
        },

        "publicbot": {
            "type": "object",
            "description": "Optional public bot. Omit the key, or leave token empty, to not start it.",
            "required": ["token"],
            "additionalProperties": false,
            "properties": {
                "token": { "type": "string" }
            }
        },

        "3xui": {
            "type": "object",
            "description": "3x-ui panels.",
            "additionalProperties": {
                "type": "object",
                "required": ["name", "address", "port", "uri", "token", "https", "whitelist", "inbounds_list", "mode"],
                "additionalProperties": false,
                "properties": {
                    "name": { "type": "string" },
                    "address": { "type": "string" },
                    "port": { "type": ["string", "integer"] },
                    "uri": { "type": "string" },
                    "token": { "type": "string", "minLength": 20, "description": "Admin-scoped 3x-ui API token (panel Settings -> Security -> API Token)." },
                    "https": { "type": "boolean" },
                    "whitelist": { "type": "boolean" },
                    "nginx_auth": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 2,
                        "maxItems": 2
                    },
                    "inbounds_list": {
                        "type": "array",
                        "items": { "type": "integer" }
                    },
                    "mode": {
                        "type": "string",
                        "enum": ["whitelist", "blacklist"]
                    },
                    "inject_headers": { "type": "object" }
                }
            }
        },

        "profiles": {
            "type": "object",
            "description": "One object per inbound. The map key is the inbound id.",
            "additionalProperties": { "$ref": "#/$defs/profile" }
        },

        "redis": {
            "type": "object",
            "description": "Shared rate-limit store. Every worker must use the same Redis.",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
                "url": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Redis URL, for example redis://127.0.0.1:6379/0."
                },
                "socket_timeout": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Connect and command timeout in seconds."
                }
            }
        }
    },

    "$defs": {
        "bilingualPair": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
        },
        "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "flag", "name", "json", "description", "whitelist",
                "xhttpExtra", "masterLink", "node", "shortProfileDescription"
            ],
            "properties": {
                "flag": { "type": "string", "description": "Emoji shown beside the profile name. Empty is valid." },
                "name": { "$ref": "#/$defs/bilingualPair" },
                "json": { "type": "object", "description": "Xray outbound. Not schema-checked beyond being an object." },
                "description": { "$ref": "#/$defs/bilingualPair" },
                "whitelist": { "type": "boolean" },
                "xhttpExtra": { "type": "object" },
                "masterLink": { "type": "string" },
                "node": {
                    "type": "string",
                    "description": "Must be a key of the top-level nodes object. JSON Schema cannot express that; a wrong key raises KeyError at runtime."
                },
                "shortProfileDescription": { "$ref": "#/$defs/bilingualPair" }
            }
        },
        "langStrings": {
            "type": "object",
            "additionalProperties": { "type": "string" }
        }
    }
}
