{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Snapshots of panel/system states",
  "description": "Daily snapshots of app, system and panel status.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "default": 90,
          "description": "How many days of history to keep"
        },
        "last_prune": {
          "type": "integer",
          "description": "Unix timestamp of last prune run"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "!!! keep in sync with custom_types.py",
      "description": "Snapshots of the system and service state.",
      "properties": {
        "cpu": {
          "type": "number"
        },
        "process_count": {
          "type": "number"
        },
        "uptime": {
          "type": "number"
        },
        "cpu_info": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cores": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "mhz_max": {
              "type": "number"
            }
          },
          "required": [
            "name",
            "mhz_max"
          ]
        },
        "loadavg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "load_1m": {
              "type": "number"
            },
            "load_5m": {
              "type": "number"
            },
            "load_15m": {
              "type": "number"
            }
          },
          "required": [
            "load_1m",
            "load_5m",
            "load_15m"
          ]
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sent": {
              "type": "integer"
            },
            "recv": {
              "type": "integer"
            }
          },
          "required": [
            "sent",
            "recv"
          ]
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ram": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "total": {
                  "type": "integer"
                },
                "available": {
                  "type": "integer"
                },
                "used": {
                  "type": "integer"
                }
              },
              "required": [
                "total",
                "available",
                "used"
              ]
            },
            "swap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "total": {
                  "type": "integer"
                },
                "free": {
                  "type": "integer"
                },
                "used": {
                  "type": "integer"
                }
              },
              "required": [
                "total",
                "free",
                "used"
              ]
            }
          },
          "required": [
            "ram",
            "swap"
          ]
        },
        "ip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ipv4": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ipv6": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ipv4",
            "ipv6"
          ]
        },
        "connections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tcp": {
              "type": "integer"
            },
            "udp": {
              "type": "integer"
            }
          },
          "required": [
            "tcp",
            "udp"
          ]
        },
        "app_memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ram": {
              "type": "number"
            },
            "swap": {
              "type": "number"
            }
          },
          "required": [
            "ram",
            "swap"
          ]
        },
        "app_uptime": {
          "type": "number"
        },
        "app_thread_amount": {
          "type": "number"
        },
        "app_threads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "ident": {
                "type": "integer"
              },
              "daemon": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "daemon"
            ]
          }
        },
        "app_gc_stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gc_counts": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "gc_thresholds": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "gc_stats": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "collections": {
                    "type": "integer"
                  },
                  "collected": {
                    "type": "integer"
                  },
                  "uncollectable": {
                    "type": "integer"
                  }
                },
                "required": [
                  "collections",
                  "collected",
                  "uncollectable"
                ]
              }
            }
          },
          "required": [
            "gc_counts",
            "gc_thresholds",
            "gc_stats"
          ]
        }
      },
      "required": [
        "cpu",
        "process_count",
        "uptime",
        "cpu_info",
        "loadavg",
        "network",
        "memory",
        "ip",
        "connections",
        "app_memory",
        "app_uptime",
        "app_thread_amount",
        "app_threads",
        "app_gc_stats"
      ]
    },
    "panels": {
      "type": "object",
      "$comment": "tracking custom_types.ServerMetricsObj",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cpu",
          "cpuCores",
          "logicalPro",
          "cpuSpeedMhz",
          "mem",
          "swap",
          "disk",
          "xray",
          "uptime",
          "loads",
          "tcpCount",
          "udpCount",
          "netIO",
          "netTraffic",
          "publicIP",
          "appStats"
        ],
        "properties": {
          "cpu": {
            "type": "number"
          },
          "cpuCores": {
            "type": "integer"
          },
          "logicalPro": {
            "type": "integer"
          },
          "cpuSpeedMhz": {
            "type": "number"
          },
          "mem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "total"
            ],
            "properties": {
              "current": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "swap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "total"
            ],
            "properties": {
              "current": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "disk": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "total"
            ],
            "properties": {
              "current": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "xray": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "errorMsg",
              "version"
            ],
            "properties": {
              "state": {
                "type": "string"
              },
              "errorMsg": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "uptime": {
            "type": "integer"
          },
          "loads": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "tcpCount": {
            "type": "integer"
          },
          "udpCount": {
            "type": "integer"
          },
          "netIO": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "up",
              "down"
            ],
            "properties": {
              "up": {
                "type": "integer"
              },
              "down": {
                "type": "integer"
              }
            }
          },
          "netTraffic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sent",
              "recv"
            ],
            "properties": {
              "sent": {
                "type": "integer"
              },
              "recv": {
                "type": "integer"
              }
            }
          },
          "publicIP": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ipv4",
              "ipv6"
            ],
            "properties": {
              "ipv4": {
                "type": "string"
              },
              "ipv6": {
                "type": "string"
              }
            }
          },
          "appStats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "threads",
              "mem",
              "uptime"
            ],
            "properties": {
              "threads": {
                "type": "integer"
              },
              "mem": {
                "type": "integer"
              },
              "uptime": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}